<div class="scrollable">
    <table class="si-table">
        <thead>
            <tr>
                <th>{{localize "pf2e-skill-issue.skill"}}</th>
                {{#each levels as |level|}}
                    <th class="si-col-{{level.value}}" style="text-align:center;">
                        <p>{{level.label}}</p>
                        <p class="si-allowance-{{level.value}}"></p>
                    </th>
                {{/each}}
                <th class="si-col-override">{{localize "pf2e-skill-issue.override"}}</th>
                <th>{{localize "pf2e-skill-issue.final-proficiency"}}</th>
            </tr>
        </thead>
        <tbody>
            {{#each skills as |skill|}}
                <tr class="si-tr si-row-{{skill.slug}}">
                    <td class="si-td" id="skill-{{slug}}">{{skill.label}}</td>
                    {{#each ../levels as |level|}}
                        <td class="si-td si-row-{{skill.slug}} si-col-{{level.value}}" style="text-align:center;">
                            <p class="si-disabled si-lock"><i class="fa-solid fa-lock"></i></p>
                            <select class="si-select" name="cell-{{level.value}}-{{skill.slug}}">
                                <option value="-">&mdash;</option>
                                {{#each @root/ranks as |rank|}}
                                    <option value="{{@index}}">
                                        {{localize rank.labelShort}}
                                    </option>
                                {{/each}}
                            </select>
                        </td>
                    {{/each}}
                    <td class="si-td si-col-override" id="skill-{{slug}}-override" style="text-align:center;">
                        <select class="si-select" name="cell-override-{{slug}}">
                            <option value="-">&mdash;</option>
                            {{#each @root/ranks as |rank|}}
                                <option value="{{@index}}">
                                    {{localize rank.labelShort}}
                                </option>
                            {{/each}}
                        </select>
                    </td>
                    <td class="si-td si-bg" id="skill-{{slug}}-final" style="text-align: center;"></td>
                </tr>
            {{/each}}
        </tbody>
    </table>
    <fieldset>
        <legend>{{localize "pf2e-skill-issue.note"}}</legend>
        <textarea name="note" placeholder="{{localize "pf2e-skill-issue.note-placeholder"}}">{{note}}</textarea>
    </fieldset>
</div>