<div class="scrollable" style="width:400px;">
    {{formGroup planAheadCapField value=planAheadCap label="pf2e-skill-issue.config.plan-ahead-level-cap" hint="pf2e-skill-issue.config.plan-ahead-level-cap-hint" name="planAheadCap" localize="true"}}
    <p></p>
    {{formGroup markAutoBackgroundClassField value=markAutoBackgroundClass label="pf2e-skill-issue.config.mark-auto-background-class" hint="pf2e-skill-issue.config.mark-auto-background-class-hint" name="markAutoBackgroundClass" localize="true"}}
    <p></p>
    <fieldset style="display:flex;flex-wrap: wrap;flex-direction:row; justify-items: space-between;">
        <legend>{{localize "pf2e-skill-issue.config.choice-cap-override"}}</legend>
        {{#each overrides}}
            <div class="form-group" style="max-width:20%">
                <label for="override-level-{{this.level}}" style="text-align:right;">{{this.label}}</label>
                <input type="number" name="override-level-{{this.level}}" id="override-level-{{this.level}}"
                    value="{{this.override}}" placeholder="{{this.allowance}}" step="1" min="0" style="flex:0.7" />
            </div>
        {{/each}}
    </fieldset>
    <p class="hint">{{localize "pf2e-skill-issue.config.choice-cap-override-hint"}}</p>
    <p></p>
    {{formGroup paragonSkillField value=paragonSkills label="pf2e-skill-issue.config.paragon-skill" hint="pf2e-skill-issue.config.paragon-skill-hint" name="paragonSkills" localize="true"}}
    <p></p>
    {{formGroup backgroundSkillField value=backgroundSkills label="pf2e-skill-issue.config.background-skill-manual" hint="pf2e-skill-issue.config.background-skill-manual-hint" name="backgroundSkills" localize="true"}}
    <p></p>
    {{formGroup classSkillField value=classSkills label="pf2e-skill-issue.config.class-skill-manual" hint="pf2e-skill-issue.config.class-skill-manual-hint" name="classSkills" localize="true"}}
</div>